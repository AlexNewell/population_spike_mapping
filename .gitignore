data/
*.tif
*.tiff
*.npz
*.npy
*.zip
*.part
*.blend
*.blend1

# --- Generated renders: reproducible from config/ + code, and binary images bloat git history.
# The showcase images are curated copies in docs/img/; full sets go in GitHub Releases.
renders/

# --- OS / editor / sync-client files
.DS_Store
Thumbs.db
desktop.ini
*.lnk
.vscode/
.idea/
*.log
